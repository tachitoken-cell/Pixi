# This file contains public configuration only. Copy to .env on the regional host.
# Set the existing canonical EU database through a reachable, verified TLS endpoint.
# All realms must use the same DB; never substitute the original empty US DB.
DATABASE_URL=
DATABASE_CA_BASE64=
# Only needed to recover/use the old optional local-storage profile.
# Preserve the existing value on a provisioned host; do not rotate it here.
POSTGRES_PASSWORD=
# Keep these US defaults on the existing host; see README.md for Asia setup.
REALM_ID=us
REALM_HOST=us.mossvale.world
REALM_EU_ORIGIN=https://mossvale.world
REALM_US_ORIGIN=https://us.mossvale.world
# Keep blank until the Asia host is ready for activation.
REALM_ASIA_ORIGIN=
GAME_ALLOWED_ORIGINS=https://mossvale.world
# Verified against the existing EU /api/config. Recheck before provisioning.
KEYCLOAK_URL=https://auth.mossvale.world
KEYCLOAK_REALM=mossvale
KEYCLOAK_CLIENT_ID=mossvale-browser
# Preserve the EU account namespace if it has an explicit issuer override.
KEYCLOAK_ACCOUNT_ISSUER=
# Optional player-controlled embedded wallets. Public IDs only; see ../TURNKEY.md.
TURNKEY_ORGANIZATION_ID=
TURNKEY_AUTH_PROXY_CONFIG_ID=
# Fee-only sponsorship. Server credentials only; all limits are explicit wei.
# This key also routes default Robinhood mainnet chain verification through Alchemy.
ALCHEMY_WALLET_API_KEY=
ALCHEMY_GAS_POLICY_ID=
TURNKEY_SPONSOR_MAX_OPERATION_WEI=
TURNKEY_SPONSOR_ACCOUNT_DAILY_WEI=
TURNKEY_SPONSOR_WALLET_DAILY_WEI=
TURNKEY_SPONSOR_GLOBAL_DAILY_WEI=
TURNKEY_SPONSOR_GLOBAL_DAILY_OPERATIONS=
TURNKEY_SPONSOR_MAX_FEE_PER_GAS_WEI=
# Optional crypto auctions: copy the same deployed contracts, chain IDs and
# authority configuration securely from EU. Leave blank to disable settlement.
AUCTION_CONTRACT=
AUCTION_AUTHORITY_KEY=
AUCTION_RPC_URL=
AUCTION_CHAIN_ID=
# Keep off until all realms have the referral-compatible release. See deploy/PRODUCTION.md.
REFERRALS_ENABLED=0
MOSS_AUCTION_CONTRACT=
MOSS_AUCTION_AUTHORITY_KEY=
MOSS_AUCTION_RPC_URL=
MOSS_AUCTION_CHAIN_ID=
# Activate arena wagers only after all realm readers preserve arenaWagers.
MOSS_ARENA_CONTRACT=
MOSS_ARENA_AUTHORITY_KEY=
MOSS_ARENA_RPC_URL=
# The store uses its own burn contract. Use the same store deployment in every realm.
STORE_CONTRACT=
# Retain the original contract here when replacing it, until every old purchase resolves.
STORE_LEGACY_CONTRACT=
STORE_AUTHORITY_KEY=
STORE_RPC_URL=
# Treasure voucher payouts use the same deployed treasury and server-only authority in every realm.
TREASURE_TREASURY_CONTRACT=
TREASURE_AUTHORITY_KEY=
TREASURE_RPC_URL=
# Optional NFTs: use the same two collections, fee receiver and server-only
# signing authority in every realm. Leave all blank until ready to enable.
NFT_PETS_CONTRACT=
NFT_HOUSES_CONTRACT=
NFT_FEE_RECEIVER=
NFT_AUTHORITY_KEY=
# Optional RPC override; the NFT integration defaults to Robinhood Chain.
NFT_RPC_URL=

# Optional paid Google Cloud Translation Basic integration; blank keeps it disabled.
# Restrict the key to Cloud Translation and the realm host IPs. Never use VITE_.
GOOGLE_TRANSLATE_API_KEY=
# Per-realm, in-memory guard; resets at UTC midnight or restart. Also set the
# shared Google project's daily character quota before enabling (see docs).
CHAT_TRANSLATION_DAILY_CHARACTERS=5000
