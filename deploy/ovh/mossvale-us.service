[Unit]
Description=Mossvale regional game server
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mossvale/deploy/ovh
ExecStart=/usr/bin/docker compose up -d --wait --no-build
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
