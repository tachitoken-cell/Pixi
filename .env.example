# Copy this file to .env.local for npm run dev. Fill all three Keycloak values to enable account sign-in.
# Without Keycloak configuration the local realm offers guest play and saves to .data/.
# Production: configure these only in the server environment, never as VITE_*.
PORT=2567
# Each server simulates this realm: eu, us, or asia. Characters choose at login.
REALM_ID=eu
# HTTPS origins only. Leave an unprovisioned remote realm blank to show it as unavailable.
# Each server publishes its own realm as the current origin; these also allow browser CORS/WebSockets.
REALM_EU_ORIGIN=
REALM_US_ORIGIN=
REALM_ASIA_ORIGIN=
# Optional additional exact browser origins, separated by commas. No wildcard origins.
GAME_ALLOWED_ORIGINS=
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
# Empty uses Google/Apple for the shared auth.mossvale.world/mossvale realm; custom realms default off.
# Override with google, apple, google,apple, or none to disable both. Secrets stay in Keycloak.
KEYCLOAK_SOCIAL_PROVIDERS=
# Account management uses the exact trusted account.mossvale.world origin.
# Configure the Keycloak callbacks described in docs/account-management.md.
# Dedicated server-only Keycloak service client; never use VITE_/EXPO_PUBLIC_ names.
KEYCLOAK_DELETE_CLIENT_ID=
KEYCLOAK_DELETE_CLIENT_SECRET=
# Defaults to KEYCLOAK_REALM.
KEYCLOAK_DELETE_CLIENT_REALM=
DATABASE_URL=
DATABASE_CA_BASE64=
# All production realms must use the same canonical PostgreSQL database and
# mossvale_players table. Account ownership locks protect shared progress; auctions are global.
# Guest/local saves: EU .data/players.json; other realms .data/players-<realm>.json.
# Referrals default on for a configured production MOSS Auction House contract on chain 4663.
# Other or missing auction routes default off. Optional: 0 disables; 1 explicitly enables.
# REFERRALS_ENABLED=0
