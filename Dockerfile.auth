FROM quay.io/keycloak/keycloak:26.7.3 AS keycloak

FROM eclipse-temurin:21-jdk AS apple-provider
WORKDIR /build
COPY --from=keycloak /opt/keycloak/lib/lib /build/lib
COPY auth-provider /build/provider
RUN mkdir classes && javac --release 21 -cp 'lib/main/*:lib/boot/*' -d classes provider/src/world/mossvale/auth/*.java \
    && jar --create --file /build/mossvale-apple.jar -C classes . -C provider/resources .

FROM node:22-alpine AS theme
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY src/login-scene.ts src/login-scene.ts
COPY auth-theme auth-theme
COPY scripts/build-auth-theme.mjs scripts/build-auth-theme.mjs
COPY scripts/check-auth-theme-build.mjs scripts/check-auth-theme-build.mjs
COPY public/models/creator-scene.glb public/models/creator-scene.glb
COPY public/ui/wordmark.png public/ui/wordmark.png
COPY public/ui/wood-frame.png public/ui/wood-frame.png
RUN node scripts/check-auth-theme-build.mjs

FROM keycloak
COPY --from=apple-provider --chown=keycloak:keycloak /build/mossvale-apple.jar /opt/keycloak/providers/mossvale-apple.jar
COPY --from=theme --chown=keycloak:keycloak /build/artifacts/auth-theme/mossvale /opt/keycloak/themes/mossvale
COPY --chown=keycloak:keycloak --chmod=755 auth-theme/entrypoint.sh /opt/keycloak/bin/mossvale-entrypoint.sh
ENV KC_HEALTH_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build --db=postgres
ENTRYPOINT ["/opt/keycloak/bin/mossvale-entrypoint.sh"]
CMD ["start", "--optimized"]
